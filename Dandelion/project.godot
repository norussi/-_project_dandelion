; Open with Godot 4.3+ (Compatibility renderer).
config_version=5

[application]

config/name="민들레 — Dandelion"
config/description="경험해 보지 못한 상황을, 게임으로 체험하다."
config/version="0.2.0"
run/main_scene="res://menu/main_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

Settings="*res://core/settings.gd"
Game="*res://core/game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
textures/default_filters/use_nearest_mipmap_filter=false

[audio]

general/text_to_speech=true
